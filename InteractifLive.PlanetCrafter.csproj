<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>InteractifLive.PlanetCrafter</AssemblyName>
    <RootNamespace>InteractifLive.PlanetCrafter</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\The Planet Crafter</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="build\**" />
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(UnityEngineRef)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
